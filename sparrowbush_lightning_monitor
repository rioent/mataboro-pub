def heading(text: str) -> None:
    print(f"\n{BOLD}{CYAN}{text}{RESET}")
    print("=" * len(text))


def subheading(text: str) -> None:
    print(f"\n{BOLD}{text}{RESET}")
    print("-" * len(text))


def http_bytes(url: str, *, accept: str = "*/*", timeout: int = 30) -> bytes:
    headers = {"User-Agent": USER_AGENT, "Accept": accept}
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as response:
        return response.read()


def http_json(url: str, *, timeout: int = 30) -> Any:
    return json.loads(http_bytes(url, accept="application/json", timeout=timeout).decode("utf-8"))


def geocode_address() -> tuple[float, float, str]:
    if LOCATION_CACHE.exists():
        try:
            cached = json.loads(LOCATION_CACHE.read_text())
            if cached.get("address") == ADDRESS:
                return float(cached["lat"]), float(cached["lon"]), str(cached.get("source", "cached"))
        except Exception:
            pass

    # U.S. Census geocoder first.
    params = urllib.parse.urlencode(
        {
            "address": ADDRESS,
            "benchmark": "Public_AR_Current",
            "format": "json",
        }
    )
    census_url = f"https://geocoding.geo.census.gov/geocoder/locations/onelineaddress?{params}"
    try:
        data = http_json(census_url)
        matches = data.get("result", {}).get("addressMatches", [])
        if matches:
            coords = matches[0]["coordinates"]
            lat, lon = float(coords["y"]), float(coords["x"])
            LOCATION_CACHE.write_text(json.dumps({"address": ADDRESS, "lat": lat, "lon": lon, "source": "U.S. Census Geocoder"}))
            return lat, lon, "U.S. Census Geocoder"
    except Exception:
        pass

    # OpenStreetMap Nominatim fallback.
    query = urllib.parse.urlencode({"q": ADDRESS, "format": "jsonv2", "limit": 1, "countrycodes": "us"})
    nominatim_url = f"https://nominatim.openstreetmap.org/search?{query}"
    data = http_json(nominatim_url)
    if not data:
        raise RuntimeError("The target address could not be geocoded.")
    lat, lon = float(data[0]["lat"]), float(data[0]["lon"])
    LOCATION_CACHE.write_text(json.dumps({"address": ADDRESS, "lat": lat, "lon": lon, "source": "OpenStreetMap Nominatim"}))
    return lat, lon, "OpenStreetMap Nominatim"


def haversine_miles(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    radius = 3958.7613
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp = math.radians(lat2 - lat1)
    dl = math.radians(lon2 - lon1)
    a = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * radius * math.atan2(math.sqrt(a), math.sqrt(1 - a))


def bearing_degrees(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dl = math.radians(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    return (math.degrees(math.atan2(y, x)) + 360) % 360


def cardinal(deg: float) -> str:
    names = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
    return names[int((deg + 11.25) // 22.5) % 16]


def sector8(deg: float) -> str:
    names = ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
    return names[int((deg + 22.5) // 45) % 8]


def parse_goes_key_time(key: str) -> datetime | None:
    match = re.search(r"_s(\d{4})(\d{3})(\d{2})(\d{2})(\d{2})(\d)", key)
    if not match:
        return None
    year, day, hour, minute, second, tenth = match.groups()
    base = datetime.strptime(f"{year}{day}{hour}{minute}{second}", "%Y%j%H%M%S").replace(tzinfo=timezone.utc)
    return base + timedelta(milliseconds=int(tenth) * 100)


def parse_seconds_since(units: str, fallback: datetime) -> datetime:
    match = re.search(r"seconds\s+since\s+(.+)", units, flags=re.I)
    if not match:
        return fallback
    text = match.group(1).strip().replace("Z", "+00:00")
    text = text.replace(" UTC", "+00:00")
    try:
        dt = datetime.fromisoformat(text)
    except ValueError:
        try:
            dt = datetime.strptime(text.split(".")[0], "%Y-%m-%d %H:%M:%S")
        except ValueError:
            return fallback
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


@dataclass(frozen=True)
class Flash:
    timestamp: datetime
    lat: float
    lon: float
    distance_mi: float
    bearing_deg: float
    energy_j: float | None
    area_m2: float | None
    duration_s: float | None
    group_count: int | None
    quality_flag: int | None

    @property
    def age_minutes(self) -> float:
        return max(0.0, (datetime.now(timezone.utc) - self.timestamp).total_seconds() / 60.0)

    @property
    def area_km2(self) -> float | None:
        if self.area_m2 is None:
            return None
        return self.area_m2 / 1_000_000.0


def s3_hour_keys(satellite: str, hour: datetime) -> list[str]:
    prefix = f"{GOES_PRODUCT}/{hour.year:04d}/{hour.timetuple().tm_yday:03d}/{hour.hour:02d}/"
    base = f"https://noaa-goes{satellite}.s3.amazonaws.com/"
    keys: list[str] = []
    continuation: str | None = None

    while True:
        query: dict[str, str] = {"list-type": "2", "prefix": prefix, "max-keys": "1000"}
        if continuation:
            query["continuation-token"] = continuation
        url = base + "?" + urllib.parse.urlencode(query)
        xml_data = http_bytes(url, accept="application/xml", timeout=35)
        root = ET.fromstring(xml_data)
        keys.extend(element.text for element in root.findall(".//{*}Key") if element.text)
        truncated = (root.findtext(".//{*}IsTruncated") or "false").lower() == "true"
        continuation = root.findtext(".//{*}NextContinuationToken")
        if not truncated or not continuation:
            break
    return keys


def candidate_goes_keys(satellite: str, start: datetime, end: datetime) -> list[str]:
    first_hour = start.replace(minute=0, second=0, microsecond=0)
    last_hour = end.replace(minute=0, second=0, microsecond=0)
    hour = first_hour
    keys: list[str] = []
    while hour <= last_hour:
        keys.extend(s3_hour_keys(satellite, hour))
        hour += timedelta(hours=1)

    selected: list[tuple[datetime, str]] = []
    for key in keys:
        key_time = parse_goes_key_time(key)
        if key_time is None:
            continue
        if start - timedelta(seconds=30) <= key_time <= end + timedelta(minutes=2):
            selected.append((key_time, key))
    selected.sort()
    return [key for _, key in selected]


def nc_values(dataset: Dataset, name: str) -> Any:
    variable = dataset.variables.get(name)
    if variable is None:
        return None
    values = variable[:]
    if hasattr(values, "filled"):
        values = values.filled(float("nan"))
    return values


def finite_float(value: Any) -> float | None:
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return number if math.isfinite(number) else None


def parse_glm_file(payload: bytes, key: str, target_lat: float, target_lon: float,
                   start: datetime, end: datetime) -> list[Flash]:
    key_time = parse_goes_key_time(key) or start
    flashes: list[Flash] = []

    with tempfile.NamedTemporaryFile(suffix=".nc") as temp_file:
        temp_file.write(payload)
        temp_file.flush()
        with Dataset(temp_file.name, mode="r") as dataset:
            lats = nc_values(dataset, "flash_lat")
            lons = nc_values(dataset, "flash_lon")
            first_offsets = nc_values(dataset, "flash_time_offset_of_first_event")
            if lats is None or lons is None or first_offsets is None:
                return flashes

            last_offsets = nc_values(dataset, "flash_time_offset_of_last_event")
            energies = nc_values(dataset, "flash_energy")
            areas = nc_values(dataset, "flash_area")
            groups = nc_values(dataset, "flash_child_group_count")
            quality = nc_values(dataset, "flash_quality_flag")
            units = getattr(dataset.variables["flash_time_offset_of_first_event"], "units", "")
            time_base = parse_seconds_since(str(units), key_time)

            for index in range(len(lats)):
                flash_lat = finite_float(lats[index])
                flash_lon = finite_float(lons[index])
                offset = finite_float(first_offsets[index])
                if flash_lat is None or flash_lon is None or offset is None:
                    continue

                timestamp = time_base + timedelta(seconds=offset)
                if timestamp < start or timestamp > end + timedelta(minutes=2):
                    continue

                distance = haversine_miles(target_lat, target_lon, flash_lat, flash_lon)
                if distance > RADIUS_MI:
                    continue

                duration = None
                if last_offsets is not None:
                    last_offset = finite_float(last_offsets[index])
                    if last_offset is not None:
                        duration = max(0.0, last_offset - offset)

                group_count = None
                if groups is not None:
                    group_value = finite_float(groups[index])
                    if group_value is not None:
                        group_count = int(group_value)

                quality_flag = None
                if quality is not None:
                    quality_value = finite_float(quality[index])
                    if quality_value is not None:
                        quality_flag = int(quality_value)

                flashes.append(
                    Flash(
                        timestamp=timestamp,
                        lat=flash_lat,
                        lon=flash_lon,
                        distance_mi=distance,
                        bearing_deg=bearing_degrees(target_lat, target_lon, flash_lat, flash_lon),
                        energy_j=finite_float(energies[index]) if energies is not None else None,
                        area_m2=finite_float(areas[index]) if areas is not None else None,
                        duration_s=duration,
                        group_count=group_count,
                        quality_flag=quality_flag,
                    )
                )
    return flashes


def get_lightning(lat: float, lon: float) -> tuple[list[Flash], str | None, dict[str, Any]]:
    now = datetime.now(timezone.utc).replace(microsecond=0)
    start = now - timedelta(minutes=LOOKBACK_MIN)
    metadata: dict[str, Any] = {
        "satellite": None,
        "files_listed": 0,
        "files_downloaded": 0,
        "files_parsed": 0,
        "files_failed": 0,
        "bytes_downloaded": 0,
        "latest_file_time": None,
    }
    listing_errors: list[str] = []
    keys: list[str] = []
    satellite = GOES_PRIMARY

    for candidate in (GOES_PRIMARY, GOES_FALLBACK):
        try:
            keys = candidate_goes_keys(candidate, start, now)
        except Exception as exc:
            listing_errors.append(f"GOES-{candidate}: {exc}")
            keys = []
        if keys:
            satellite = candidate
            break

    if not keys:
        detail = "; ".join(listing_errors) if listing_errors else "no recent GLM files were listed"
        return [], f"NOAA GOES GLM data unavailable: {detail}", metadata

    metadata["satellite"] = satellite
    metadata["files_listed"] = len(keys)
    metadata["latest_file_time"] = parse_goes_key_time(keys[-1])
    base = f"https://noaa-goes{satellite}.s3.amazonaws.com/"
    flashes: list[Flash] = []
    seen: set[tuple[Any, ...]] = set()

    def download(key: str) -> tuple[str, bytes]:
        quoted_key = urllib.parse.quote(key, safe="/")
        return key, http_bytes(base + quoted_key, accept="application/x-netcdf", timeout=45)

    with ThreadPoolExecutor(max_workers=12) as executor:
        futures = [executor.submit(download, key) for key in keys]
        for future in as_completed(futures):
            try:
                key, payload = future.result()
                metadata["files_downloaded"] += 1
                metadata["bytes_downloaded"] += len(payload)
                parsed = parse_glm_file(payload, key, lat, lon, start, now)
                metadata["files_parsed"] += 1
                for flash in parsed:
                    dedupe_key = (
                        round(flash.timestamp.timestamp(), 3),
                        round(flash.lat, 4),
                        round(flash.lon, 4),
                    )
                    if dedupe_key not in seen:
                        seen.add(dedupe_key)
                        flashes.append(flash)
            except Exception:
                metadata["files_failed"] += 1

    flashes.sort(key=lambda item: item.timestamp, reverse=True)
    if metadata["files_downloaded"] == 0:
        return [], "NOAA GLM files were listed but none could be downloaded.", metadata
    if metadata["files_parsed"] == 0:
        return [], "NOAA GLM files downloaded, but none could be decoded as NetCDF4 data.", metadata
    return flashes, None, metadata


def get_open_meteo(lat: float, lon: float) -> tuple[dict[str, Any], str | None]:
    current_vars = [
        "temperature_2m", "relative_humidity_2m", "dew_point_2m", "apparent_temperature",
        "precipitation", "rain", "showers", "weather_code",
        "cloud_cover", "cloud_cover_low", "cloud_cover_mid", "cloud_cover_high",
        "pressure_msl", "surface_pressure", "wind_speed_10m", "wind_direction_10m",
        "wind_gusts_10m", "visibility", "cape", "lifted_index", "convective_inhibition",
        "freezing_level_height", "boundary_layer_height",
        "temperature_850hPa", "dew_point_850hPa", "wind_speed_850hPa", "wind_direction_850hPa",
        "geopotential_height_850hPa", "temperature_700hPa", "dew_point_700hPa",
        "wind_speed_700hPa", "wind_direction_700hPa", "geopotential_height_700hPa",
        "temperature_500hPa", "dew_point_500hPa", "wind_speed_500hPa", "wind_direction_500hPa",
        "geopotential_height_500hPa",
    ]
    params = urllib.parse.urlencode(
        {
            "latitude": f"{lat:.6f}",
            "longitude": f"{lon:.6f}",
            "current": ",".join(current_vars),
            "temperature_unit": "celsius",
            "wind_speed_unit": "mph",
            "precipitation_unit": "inch",
            "timezone": TZ_NAME,
        }
    )
    url = f"https://api.open-meteo.com/v1/gfs?{params}"
    try:
        return http_json(url), None
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", "replace")[:500]
        return {}, f"Open-Meteo HTTP {exc.code}: {body}"
    except Exception as exc:
        return {}, f"Open-Meteo request failed: {exc}"


def get_nws_alerts(lat: float, lon: float) -> tuple[list[dict[str, Any]], str | None]:
    url = f"https://api.weather.gov/alerts/active?point={lat:.4f},{lon:.4f}"
    try:
        data = http_json(url)
        return list(data.get("features", [])), None
    except Exception as exc:
        return [], f"NWS alert request failed: {exc}"


def f_to_str(c: Any) -> str:
    if c is None:
        return "n/a"
    value = float(c)
    return f"{value * 9 / 5 + 32:.1f} °F / {value:.1f} °C"


def num(value: Any, decimals: int = 1, suffix: str = "") -> str:
    if value is None:
        return "n/a"
    try:
        return f"{float(value):.{decimals}f}{suffix}"
    except Exception:
        return str(value)


def meters_to_feet(value: Any) -> str:
    if value is None:
        return "n/a"
    return f"{float(value) * 3.28084:,.0f} ft / {float(value):,.0f} m"


def hpa_to_inhg(value: Any) -> str:
    if value is None:
        return "n/a"
    v = float(value)
    return f"{v:.1f} hPa / {v * 0.0295299831:.2f} inHg"


def vector_components(speed: float, direction_from_deg: float) -> tuple[float, float]:
    rad = math.radians(direction_from_deg)
    return -speed * math.sin(rad), -speed * math.cos(rad)


def linear_slope(points: Iterable[tuple[float, float]]) -> float | None:
    pairs = list(points)
    if len(pairs) < 3:
        return None
    xs = [p[0] for p in pairs]
    ys = [p[1] for p in pairs]
    xbar, ybar = statistics.fmean(xs), statistics.fmean(ys)
    denom = sum((x - xbar) ** 2 for x in xs)
    if denom == 0:
        return None
    return sum((x - xbar) * (y - ybar) for x, y in pairs) / denom


def movement_analysis(strikes: list[Flash]) -> tuple[str, dict[str, Any]]:
    now = datetime.now(timezone.utc)
    recent = [s for s in strikes if (now - s.timestamp).total_seconds() <= 20 * 60]
    older = [s for s in strikes if 20 * 60 < (now - s.timestamp).total_seconds() <= LOOKBACK_MIN * 60]
    details: dict[str, Any] = {"recent": recent, "older": older}

    if len(recent) < 2 or len(older) < 2:
        return "INSUFFICIENT HISTORY", details

    recent_med = statistics.median(s.distance_mi for s in recent)
    older_med = statistics.median(s.distance_mi for s in older)
    delta = recent_med - older_med
    details.update({"recent_median": recent_med, "older_median": older_med, "delta": delta})

    chronological = sorted(strikes, key=lambda s: s.timestamp)
    t0 = chronological[0].timestamp
    slope = linear_slope(((s.timestamp - t0).total_seconds() / 60.0, s.distance_mi) for s in chronological)
    details["slope"] = slope

    if delta <= -5 and (slope is None or slope < -0.05):
        return "GETTING CLOSER", details
    if delta >= 5 and (slope is None or slope > 0.05):
        return "MOVING AWAY", details
    return "MIXED OR NEARLY STATIONARY", details


def storm_risk_label(nearest: float | None) -> tuple[str, str]:
    if nearest is None:
        return "NO LIGHTNING FLASHES DETECTED IN THE LOOKBACK WINDOW", GREEN
    if nearest <= 6:
        return "EXTREME PROXIMITY", RED
    if nearest <= 10:
        return "DANGEROUSLY CLOSE", RED
    if nearest <= 25:
        return "HIGH LIGHTNING PROXIMITY", YELLOW
    if nearest <= 50:
        return "ELEVATED LIGHTNING PROXIMITY", YELLOW
    return "LIGHTNING WITHIN THE 100-MILE MONITORING AREA", CYAN


def weather_code_text(code: Any) -> str:
    mapping = {
        0: "clear", 1: "mainly clear", 2: "partly cloudy", 3: "overcast",
        45: "fog", 48: "depositing rime fog", 51: "light drizzle", 53: "drizzle",
        55: "dense drizzle", 61: "light rain", 63: "rain", 65: "heavy rain",
        80: "light rain showers", 81: "rain showers", 82: "violent rain showers",
        95: "thunderstorm", 96: "thunderstorm with slight hail", 99: "thunderstorm with heavy hail",
    }
    try:
        return mapping.get(int(code), f"WMO code {int(code)}")
    except Exception:
        return "n/a"


