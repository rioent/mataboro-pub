print(f"Monitoring radius: {RADIUS_MI:.0f} miles | Lightning lookback: {LOOKBACK_MIN} minutes")

try:
    target_lat, target_lon, geocoder = geocode_address()
except Exception as exc:
    print(f"\n{RED}Fatal geocoding error: {exc}{RESET}")
    sys.exit(2)

print(f"Target coordinate: {target_lat:.5f}, {target_lon:.5f} ({geocoder})")

flashes, lightning_error, lightning_meta = get_lightning(target_lat, target_lon)
weather, weather_error = get_open_meteo(target_lat, target_lon)
alerts, alerts_error = get_nws_alerts(target_lat, target_lon)

heading("CURRENT LIGHTNING SUMMARY")
if lightning_error:
    print(f"{YELLOW}Lightning feed unavailable: {lightning_error}{RESET}")
    print("Atmospheric and NWS alert sections are still shown below.")
else:
    satellite = lightning_meta.get("satellite") or "unknown"
    latest_file_time = lightning_meta.get("latest_file_time")
    print(f"Observation source: NOAA GOES-{satellite} GLM Level 2 total-lightning flashes")
    print(f"Files: {lightning_meta.get('files_downloaded', 0):,} downloaded, "
          f"{lightning_meta.get('files_parsed', 0):,} decoded of "
          f"{lightning_meta.get('files_listed', 0):,} listed | failures {lightning_meta.get('files_failed', 0):,}")
    print(f"Data downloaded: {lightning_meta.get('bytes_downloaded', 0) / 1_048_576:.1f} MiB")
    if isinstance(latest_file_time, datetime):
        file_lag = max(0.0, (datetime.now(timezone.utc) - latest_file_time).total_seconds() / 60.0)
        print(f"Newest GLM product start: {latest_file_time.strftime('%Y-%m-%d %H:%M:%S UTC')} "
              f"({file_lag:.1f} min old)")
    if satellite != GOES_PRIMARY:
        print(f"{YELLOW}GOES-{GOES_PRIMARY} was unavailable; GOES-{satellite} fallback data are being used.{RESET}")

    nearest = min((f.distance_mi for f in flashes), default=None)
    status, status_color = storm_risk_label(nearest)
    print(f"Status: {status_color}{BOLD}{status}{RESET}")
    print(f"Total-lightning flashes within {RADIUS_MI:.0f} miles during last {LOOKBACK_MIN} minutes: {len(flashes):,}")

    if flashes:
        latest = max(flashes, key=lambda f: f.timestamp)
        nearest_flash = min(flashes, key=lambda f: f.distance_mi)
        energies = [f.energy_j for f in flashes if f.energy_j is not None]
        areas = [f.area_km2 for f in flashes if f.area_km2 is not None]
        durations = [f.duration_s for f in flashes if f.duration_s is not None]
        groups = [f.group_count for f in flashes if f.group_count is not None]
        good_quality = sum(f.quality_flag in (None, 0) for f in flashes)

        print(f"Nearest flash centroid: {nearest_flash.distance_mi:.2f} mi {cardinal(nearest_flash.bearing_deg)} "
              f"at {nearest_flash.timestamp.astimezone(LOCAL_TZ).strftime('%H:%M:%S %Z')}")
        print(f"Latest nearby flash:    {latest.age_minutes:.1f} min ago, {latest.distance_mi:.2f} mi "
              f"{cardinal(latest.bearing_deg)}")
        print(f"Quality flag 0/unflagged: {good_quality:,} of {len(flashes):,}")
        if energies:
            print(f"Radiant energy: median {statistics.median(energies):.3e} J | maximum {max(energies):.3e} J")
        if areas:
            print(f"Flash footprint: median {statistics.median(areas):,.1f} km² | maximum {max(areas):,.1f} km²")
        if durations:
            print(f"Flash duration: median {statistics.median(durations):.3f} s | maximum {max(durations):.3f} s")
        if groups:
            print(f"Constituent groups: median {statistics.median(groups):.1f} | maximum {max(groups):,}")

        subheading("Flash counts and rate by age")
        time_bins = [(0, 5), (5, 10), (10, 20), (20, 30), (30, 45), (45, 60)]
        for low, high in time_bins:
            count = sum(low <= f.age_minutes < high for f in flashes)
            minutes = max(1, high - low)
            print(f"{low:>2}-{high:<2} minutes: {count:>6,}  ({count / minutes:>7.2f} flashes/min)")

        last_5 = sum(f.age_minutes < 5 for f in flashes)
        previous_5 = sum(5 <= f.age_minutes < 10 for f in flashes)
        if previous_5 == 0:
            rate_change = "new activity" if last_5 else "no recent activity"
        else:
            rate_change = f"{((last_5 - previous_5) / previous_5) * 100:+.1f}% versus prior 5 minutes"
        print(f"Five-minute flash-rate trend: {rate_change}")

        subheading("Flash counts by distance")
        distance_bins = [(0, 5), (5, 10), (10, 25), (25, 50), (50, 75), (75, 100)]
        for low, high in distance_bins:
            count = sum(low <= f.distance_mi < high for f in flashes)
            print(f"{low:>3}-{high:<3} miles: {count:>6,}")

        movement, movement_details = movement_analysis(flashes)
        color = RED if movement == "GETTING CLOSER" else GREEN if movement == "MOVING AWAY" else YELLOW
        subheading("Distance trend")
        print(f"Overall result: {color}{BOLD}{movement}{RESET}")
        if "recent_median" in movement_details:
            print(f"Recent 0-20 min median distance:      {movement_details['recent_median']:.1f} mi")
            print(f"Older 20-{LOOKBACK_MIN} min median distance: {movement_details['older_median']:.1f} mi")
            print(f"Median-distance change:               {movement_details['delta']:+.1f} mi")
        if movement_details.get("slope") is not None:
            slope = movement_details["slope"]
            print(f"Linear distance slope: {slope:+.3f} mi/min ({slope * 10:+.1f} mi per 10 min)")
        print(f"{DIM}This compares satellite flash-centroid distances over time. It is not radar cell tracking, "
              f"and multiple storm cells can produce a mixed result.{RESET}")

        subheading("Movement by compass sector")
        recent = movement_details.get("recent", [])
        older = movement_details.get("older", [])
        sector_rows = []
        for sector in ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]:
            recent_distances = [f.distance_mi for f in recent if sector8(f.bearing_deg) == sector]
            older_distances = [f.distance_mi for f in older if sector8(f.bearing_deg) == sector]
            if len(recent_distances) >= 2 and len(older_distances) >= 2:
                recent_median = statistics.median(recent_distances)
                older_median = statistics.median(older_distances)
                delta = recent_median - older_median
                trend = "closer" if delta <= -5 else "away" if delta >= 5 else "mixed/stable"
                sector_rows.append((sector, len(recent_distances), len(older_distances),
                                    recent_median, older_median, delta, trend))
        if not sector_rows:
            print("Insufficient flash history in individual sectors.")
        else:
            print("Sector  Recent  Older   Recent median  Older median   Change   Trend")
            for sector, recent_count, older_count, recent_median, older_median, delta, trend in sector_rows:
                print(f"{sector:<7} {recent_count:>6} {older_count:>6} {recent_median:>12.1f} mi "
                      f"{older_median:>11.1f} mi {delta:>+7.1f}  {trend}")
    else:
        print("No NOAA GLM total-lightning flashes were detected inside the 100-mile circle during the lookback period.")

heading("TECHNICAL CONVECTIVE ATMOSPHERE")
if weather_error:
    print(f"{YELLOW}{weather_error}{RESET}")
else:
    current = weather.get("current", {})
    units = weather.get("current_units", {})
    valid = current.get("time", "n/a")
    print(f"Model source: Open-Meteo GFS/HRRR seamless | Valid time: {valid} {TZ_NAME}")
    print(f"Condition: {weather_code_text(current.get('weather_code'))}")

    subheading("Surface thermodynamics")
    print(f"Temperature:            {f_to_str(current.get('temperature_2m'))}")
    print(f"Dew point:              {f_to_str(current.get('dew_point_2m'))}")
    print(f"Apparent temperature:   {f_to_str(current.get('apparent_temperature'))}")
    print(f"Relative humidity:      {num(current.get('relative_humidity_2m'), 0, ' %')}")
    if current.get("temperature_2m") is not None and current.get("dew_point_2m") is not None:
        temp_c = float(current["temperature_2m"])
        dew_c = float(current["dew_point_2m"])
        spread = temp_c - dew_c
        lcl_m = max(0.0, 125.0 * spread)
        print(f"Temperature-dewpoint spread: {spread:.1f} °C / {spread*9/5:.1f} °F")
        print(f"Estimated LCL/cloud base AGL: {lcl_m*3.28084:,.0f} ft / {lcl_m:,.0f} m")
        rh = current.get("relative_humidity_2m")
        if rh is not None:
            rhf = max(1.0, min(100.0, float(rh)))
            wet_c = (temp_c * math.atan(0.151977 * math.sqrt(rhf + 8.313659))
                     + math.atan(temp_c + rhf) - math.atan(rhf - 1.676331)
                     + 0.00391838 * rhf ** 1.5 * math.atan(0.023101 * rhf) - 4.686035)
            print(f"Estimated wet-bulb temperature: {f_to_str(wet_c)}")
    print(f"Sea-level pressure:     {hpa_to_inhg(current.get('pressure_msl'))}")
    print(f"Surface pressure:       {hpa_to_inhg(current.get('surface_pressure'))}")
    print(f"Precipitation:          {num(current.get('precipitation'), 3, ' in')}")
    print(f"Rain / showers:         {num(current.get('rain'), 3, ' in')} / {num(current.get('showers'), 3, ' in')}")

    subheading("Instability and inhibition")
    print(f"CAPE:                   {num(current.get('cape'), 0, ' J/kg')}")
    print(f"Lifted Index:           {num(current.get('lifted_index'), 1, ' °C')}")
    print(f"Convective inhibition:  {num(current.get('convective_inhibition'), 0, ' J/kg')}")
    print(f"Freezing level:         {meters_to_feet(current.get('freezing_level_height'))}")
    print(f"Boundary-layer height:  {meters_to_feet(current.get('boundary_layer_height'))}")

    subheading("Cloud structure and wind")
    print(f"Cloud cover total/low/mid/high: "
          f"{num(current.get('cloud_cover'),0,'%')} / {num(current.get('cloud_cover_low'),0,'%')} / "
          f"{num(current.get('cloud_cover_mid'),0,'%')} / {num(current.get('cloud_cover_high'),0,'%')}")
    print(f"Visibility:             {meters_to_feet(current.get('visibility'))}")
    print(f"Surface wind:           {num(current.get('wind_speed_10m'),1,' mph')} from "
          f"{num(current.get('wind_direction_10m'),0,'°')} | gusts {num(current.get('wind_gusts_10m'),1,' mph')}")

    t850, td850 = current.get("temperature_850hPa"), current.get("dew_point_850hPa")
    t700, td700 = current.get("temperature_700hPa"), current.get("dew_point_700hPa")
    t500, td500 = current.get("temperature_500hPa"), current.get("dew_point_500hPa")
    z850, z500 = current.get("geopotential_height_850hPa"), current.get("geopotential_height_500hPa")

    subheading("Pressure-level diagnostics")
    print(f"850 hPa: T {num(t850,1,' °C')} | Td {num(td850,1,' °C')} | wind "
          f"{num(current.get('wind_speed_850hPa'),1,' mph')} from {num(current.get('wind_direction_850hPa'),0,'°')}")
    print(f"700 hPa: T {num(t700,1,' °C')} | Td {num(td700,1,' °C')} | wind "
          f"{num(current.get('wind_speed_700hPa'),1,' mph')} from {num(current.get('wind_direction_700hPa'),0,'°')}")
    print(f"500 hPa: T {num(t500,1,' °C')} | Td {num(td500,1,' °C')} | wind "
          f"{num(current.get('wind_speed_500hPa'),1,' mph')} from {num(current.get('wind_direction_500hPa'),0,'°')}")

    if all(v is not None for v in (t850, td850, t700, td700, t500)):
        k_index = (float(t850) - float(t500)) + float(td850) - (float(t700) - float(td700))
        total_totals = float(t850) + float(td850) - 2 * float(t500)
        print(f"K Index:                {k_index:.1f}")
        print(f"Total Totals Index:     {total_totals:.1f}")

    if all(v is not None for v in (t850, t500, z850, z500)) and float(z500) > float(z850):
        lapse = (float(t850) - float(t500)) / ((float(z500) - float(z850)) / 1000.0)
        print(f"850-500 hPa lapse rate: {lapse:.2f} °C/km")

    sfc_speed = current.get("wind_speed_10m")
    sfc_dir = current.get("wind_direction_10m")
    mid_speed = current.get("wind_speed_500hPa")
    mid_dir = current.get("wind_direction_500hPa")
    if all(v is not None for v in (sfc_speed, sfc_dir, mid_speed, mid_dir)):
        u1, v1 = vector_components(float(sfc_speed), float(sfc_dir))
        u2, v2 = vector_components(float(mid_speed), float(mid_dir))
        shear = math.hypot(u2 - u1, v2 - v1)
        print(f"Approx. 10 m-500 hPa bulk shear: {shear:.1f} mph")

heading("ACTIVE NWS ALERTS")
if alerts_error:
    print(f"{YELLOW}{alerts_error}{RESET}")
elif not alerts:
    print("No active NWS alerts were returned for the target point.")
else:
    for feature in alerts:
        p = feature.get("properties", {})
        event = p.get("event", "Alert")
        headline = p.get("headline") or p.get("description", "").splitlines()[0]
        severity = p.get("severity", "Unknown")
        urgency = p.get("urgency", "Unknown")
        expires = p.get("expires", "n/a")
        print(f"{RED}{BOLD}{event}{RESET}")
        print(f"  Severity/Urgency: {severity} / {urgency}")
        print(f"  Expires: {expires}")
        print(f"  {headline}")

if not lightning_error and flashes:
    heading("ALL NOAA GLM FLASHES WITHIN 100 MILES")
    print("Local time           UTC time             Age    Dist.  Bearing   Latitude   Longitude    Energy(J)   Area(km²)  Dur(s)  Groups  Q")
    print("-------------------  -------------------  -----  ------  --------  ---------  ----------  -----------  ---------  ------  ------  -")
    for flash in flashes:
        local_text = flash.timestamp.astimezone(LOCAL_TZ).strftime("%Y-%m-%d %H:%M:%S")
        utc_text = flash.timestamp.strftime("%Y-%m-%d %H:%M:%S")
        energy_text = "n/a" if flash.energy_j is None else f"{flash.energy_j:.3e}"
        area_text = "n/a" if flash.area_km2 is None else f"{flash.area_km2:.1f}"
        duration_text = "n/a" if flash.duration_s is None else f"{flash.duration_s:.3f}"
        groups_text = "n/a" if flash.group_count is None else str(flash.group_count)
        quality_text = "n/a" if flash.quality_flag is None else str(flash.quality_flag)
        print(f"{local_text}  {utc_text}  {flash.age_minutes:5.1f}  {flash.distance_mi:6.2f}  "
              f"{cardinal(flash.bearing_deg):>3} {flash.bearing_deg:5.1f}°  {flash.lat:9.4f}  {flash.lon:10.4f}  "
              f"{energy_text:>11}  {area_text:>9}  {duration_text:>6}  {groups_text:>6}  {quality_text:>3}")

heading("DATA NOTES")
print("Lightning source: NOAA GOES GLM Level 2 LCFA files from NOAA's public AWS Open Data bucket.")
print("The source is free and anonymous. No subscription, username, password, or API key is used.")
print("Each listed item is a satellite-detected total-lightning flash centroid, not necessarily a ground strike point.")
print("GLM combines in-cloud, cloud-to-cloud, and cloud-to-ground activity and does not report polarity or peak current.")
print("Flash energy is optical radiant energy measured by GLM, not the electrical energy of the discharge.")
print("Atmospheric fields: Open-Meteo GFS/HRRR seamless model output; these are model-derived, not on-site readings.")
print("Warnings and watches: National Weather Service active-alert API.")
print("Movement classification compares flash-centroid distances over time. It does not replace radar storm-cell tracking.")
print("Surface electric-field strength and cloud charge density are not available from these public terminal feeds.")
print(f"{YELLOW}Do not use this report as the sole basis for lightning safety decisions. If thunder is heard, move indoors.{RESET}")
PY

