#!/usr/bin/env bash

# Install - sudo apt install python3 python3-venv python3-pip python3-netcdf4
# Install - sudo apt install python3-netcdf4

# Sparrowbush Lightning and Convective Atmosphere Monitor
# Target: 34 Whitehead Road, Sparrow Bush, NY 12780
#
# Lightning source: NOAA GOES-19 Geostationary Lightning Mapper (GLM)
# public data from the NOAA Open Data Dissemination AWS bucket.
# No subscription, account, API key, username, or password is required.
#
# GLM detects total lightning flashes, including in-cloud, cloud-to-cloud,
# and cloud-to-ground activity. It does not identify flash type, electrical
# polarity, or peak current. Locations are satellite-derived flash centroids.

set -u

ADDRESS="34 Whitehead Road, Sparrow Bush, NY 12780"
TIMEZONE="America/New_York"
RADIUS_MILES="100"
LOOKBACK_MINUTES="60"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/sparrowbush-lightning"
VENV_DIR="$CACHE_ROOT/venv"

clear 2>/dev/null || true
printf '%s\n' "SPARROWBUSH LIGHTNING MONITOR"
printf '%s\n' "$ADDRESS"
printf '\n'
printf 'Local time: %s\n' "$(TZ="$TIMEZONE" date '+%A, %B %d, %Y %I:%M:%S %p %Z')"
printf '24-hour:   %s\n' "$(TZ="$TIMEZONE" date '+%Y-%m-%d %H:%M:%S %Z')"
printf 'UTC time:  %s\n' "$(TZ=UTC date '+%Y-%m-%d %H:%M:%S UTC')"
printf '\n'

close_terminal() {
    printf '\n'
    read -r -n 1 -s -p "Press any key to close the terminal..."
    printf '\n'
}

if ! command -v python3 >/dev/null 2>&1; then
    printf 'Error: python3 is required.\n'
    close_terminal
    exit 1
fi

mkdir -p "$CACHE_ROOT"
PYTHON_BIN="python3"

# NOAA GLM files are NetCDF4. Create a small private virtual environment on
# first run so no system Python packages or paid services are required.
if ! python3 -c 'import netCDF4' >/dev/null 2>&1; then
    if [[ ! -x "$VENV_DIR/bin/python" ]]; then
        printf 'Preparing the free NOAA lightning-data reader...\n'
        if ! python3 -m venv "$VENV_DIR" >/dev/null 2>&1; then
            printf '\nUnable to create the Python virtual environment.\n'
            printf 'Install the required Linux package, then run this script again:\n'
            printf '  sudo apt install python3-venv\n'
            close_terminal
            exit 1
        fi
    fi
    PYTHON_BIN="$VENV_DIR/bin/python"
    if ! "$PYTHON_BIN" -c 'import netCDF4' >/dev/null 2>&1; then
        printf 'Installing the NetCDF reader into the private environment...\n'
        if ! "$PYTHON_BIN" -m pip install --quiet --disable-pip-version-check netCDF4; then
            printf '\nUnable to install the NetCDF reader. Check the internet connection and try again.\n'
            close_terminal
            exit 1
        fi
    fi
fi

REPORT_FILE="$(mktemp --tmpdir lightning-report.XXXXXX.txt)"
trap 'rm -f "$REPORT_FILE"' EXIT

export ADDRESS TIMEZONE RADIUS_MILES LOOKBACK_MINUTES
printf 'Retrieving NOAA GOES-19 total-lightning flashes and atmospheric data...\n'

"$PYTHON_BIN" >"$REPORT_FILE" <<'PY'
